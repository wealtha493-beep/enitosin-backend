# Copy this file to ".env" (same folder) and fill in real values.
# Never commit the real ".env" file — it's already in .gitignore.

ADMIN_KEY=choose-a-long-random-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional — only needed if you want order-notification emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=ENITOSIN Store <onboarding@resend.dev>

# Required for checkout payments to work — get these from your Paystack
# dashboard: Settings -> API Keys & Webhooks. Use the sk_test_... key
# while testing, switch to the sk_live_... key when you go live.
PAYSTACK_SECRET_KEY=

# ---- Security settings (optional but recommended in production) ----

# Your live site address, e.g. https://enitosin-store.onrender.com
# Paystack sends customers back here after paying. Setting it stops a forged
# "Host" header from redirecting buyers somewhere else.
PUBLIC_URL=

# Only needed if ANOTHER website must call this API from the browser.
# Comma-separated, e.g. https://www.mydomain.com,https://mydomain.com
# Leave empty when the store and admin are served by this same server.
ALLOWED_ORIGINS=
